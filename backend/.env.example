PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/khang?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string
# Your frontend URL (no trailing slash). Locally: http://localhost:5173
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@khang.pk
ADMIN_PASSWORD=ChangeMe123

# Order alerts (phone/laptop notifications for the admin). OPTIONAL: if these are empty the server creates and stores its own keys automatically.
# If you do set them, generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Delivery charge added to every delivery order (Rs.). Default 100.
DELIVERY_CHARGE=100

# Optional Telegram backup alert (see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
